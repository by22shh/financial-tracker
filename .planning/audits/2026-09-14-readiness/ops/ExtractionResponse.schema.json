{
  "$defs": {
    "Ambiguity": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "amount",
            "currency",
            "date",
            "category",
            "beneficiary",
            "spender",
            "account",
            "note"
          ],
          "title": "Field",
          "type": "string"
        },
        "reason": {
          "maxLength": 300,
          "title": "Reason",
          "type": "string"
        },
        "options": {
          "items": {
            "maxLength": 120,
            "type": "string"
          },
          "maxItems": 6,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "title": "Ambiguity",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "\u041e\u043f\u043e\u0440\u0430 \u043c\u043e\u0434\u0435\u043b\u0438 \u043d\u0430 \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442 \u2014 \u0434\u043b\u044f \u043f\u043e\u043a\u0430\u0437\u0430 \u00ab\u041f\u043e\u0447\u0435\u043c\u0443\u00bb.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "date": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "category": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "beneficiary": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Beneficiary"
        },
        "spender": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spender"
        },
        "merchant": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Merchant"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "ExtractionCandidate": {
      "additionalProperties": false,
      "description": "\u041e\u0434\u0438\u043d \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u0435\u043c\u044b\u0439 \u0440\u0430\u0441\u0445\u043e\u0434 \u0438\u043b\u0438 \u0434\u043e\u0445\u043e\u0434.",
      "properties": {
        "candidate_key": {
          "maxLength": 16,
          "pattern": "^c\\d{1,3}$",
          "title": "Candidate Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "expense",
            "income",
            "transfer",
            "refund",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "amount_decimal": {
          "anyOf": [
            {
              "pattern": "^-?\\d{1,15}(\\.\\d{1,4})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Decimal"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 3,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "currency_origin": {
          "default": "unknown",
          "enum": [
            "message",
            "workspace_default",
            "unknown"
          ],
          "title": "Currency Origin",
          "type": "string"
        },
        "date_expression": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Expression"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "merchant": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Merchant"
        },
        "category_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Id"
        },
        "beneficiary_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Beneficiary Id"
        },
        "spender_person_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spender Person Id"
        },
        "account_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "ambiguities": {
          "items": {
            "$ref": "#/$defs/Ambiguity"
          },
          "maxItems": 8,
          "title": "Ambiguities",
          "type": "array"
        }
      },
      "required": [
        "candidate_key",
        "kind"
      ],
      "title": "ExtractionCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "\u041e\u0442\u0432\u0435\u0442 \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u044f (AI-01, \u0440\u0430\u0437\u0434\u0435\u043b 18.1 \u0422\u0417).",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "intent": {
      "enum": [
        "record_transaction",
        "question",
        "hypothetical",
        "negated",
        "future_plan",
        "change_limit",
        "create_category",
        "correct_transaction",
        "cancel_transaction",
        "add_note",
        "reminder",
        "unknown"
      ],
      "title": "Intent",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ExtractionCandidate"
      },
      "maxItems": 10,
      "title": "Candidates",
      "type": "array"
    },
    "question": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question"
    }
  },
  "required": [
    "schema_version",
    "intent"
  ],
  "title": "ExtractionResponse",
  "type": "object"
}