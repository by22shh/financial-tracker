{
  "$defs": {
    "Ambiguity": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "amount",
            "currency",
            "date",
            "category",
            "beneficiary",
            "spender",
            "account",
            "note"
          ],
          "title": "Field",
          "type": "string"
        },
        "reason": {
          "maxLength": 300,
          "title": "Reason",
          "type": "string"
        },
        "options": {
          "items": {
            "maxLength": 120,
            "type": "string"
          },
          "maxItems": 6,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "title": "Ambiguity",
      "type": "object"
    },
    "ReceiptLine": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 300,
          "title": "Label",
          "type": "string"
        },
        "amount_decimal": {
          "pattern": "^-?\\d{1,15}(\\.\\d{1,4})?$",
          "title": "Amount Decimal",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "maxLength": 24,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "unit_price_decimal": {
          "anyOf": [
            {
              "pattern": "^-?\\d{1,15}(\\.\\d{1,4})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price Decimal"
        },
        "category_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Id"
        },
        "readable": {
          "default": true,
          "title": "Readable",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "amount_decimal"
      ],
      "title": "ReceiptLine",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "\u0420\u0430\u0437\u0431\u043e\u0440 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0447\u0435\u043a\u0430 (FR-14\u2013FR-17).",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "document_kind": {
      "enum": [
        "receipt",
        "invoice",
        "cart",
        "order_confirmation",
        "bank_screenshot",
        "other"
      ],
      "title": "Document Kind",
      "type": "string"
    },
    "payment_confirmed": {
      "default": false,
      "title": "Payment Confirmed",
      "type": "boolean"
    },
    "merchant": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Merchant"
    },
    "date_expression": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date Expression"
    },
    "currency": {
      "anyOf": [
        {
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "total_decimal": {
      "anyOf": [
        {
          "pattern": "^-?\\d{1,15}(\\.\\d{1,4})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Decimal"
    },
    "discount_decimal": {
      "anyOf": [
        {
          "pattern": "^-?\\d{1,15}(\\.\\d{1,4})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Discount Decimal"
    },
    "tip_decimal": {
      "anyOf": [
        {
          "pattern": "^-?\\d{1,15}(\\.\\d{1,4})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tip Decimal"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/ReceiptLine"
      },
      "maxItems": 100,
      "title": "Lines",
      "type": "array"
    },
    "unreadable_lines": {
      "default": 0,
      "maximum": 500,
      "minimum": 0,
      "title": "Unreadable Lines",
      "type": "integer"
    },
    "fiscal_id": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fiscal Id"
    },
    "is_refund": {
      "default": false,
      "title": "Is Refund",
      "type": "boolean"
    },
    "ambiguities": {
      "items": {
        "$ref": "#/$defs/Ambiguity"
      },
      "maxItems": 8,
      "title": "Ambiguities",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "document_kind"
  ],
  "title": "ReceiptResponse",
  "type": "object"
}