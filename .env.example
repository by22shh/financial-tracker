# ---------------------------------------------------------------------------
# Пример конфигурации. Секреты не хранятся в репозитории (ADR-13, OPS-03).
# Скопируйте в .env и подставьте значения своей среды.
# ---------------------------------------------------------------------------

FINTRACKER_ENV=dev                     # dev | test | prod

# --- База данных -----------------------------------------------------------
# Владелец схемы (миграции). Приложением НЕ используется.
FINTRACKER_DB__OWNER_DSN=postgresql+psycopg://fintracker_owner:devpassword@localhost:55432/fintracker
# Ограниченная runtime роль API (без BYPASSRLS, не владелец таблиц) — SEC-02
FINTRACKER_DB__API_DSN=postgresql+psycopg://fintracker_api:devpassword@localhost:55432/fintracker
# Ограниченная runtime роль worker/scheduler
FINTRACKER_DB__WORKER_DSN=postgresql+psycopg://fintracker_worker:devpassword@localhost:55432/fintracker
FINTRACKER_DB__API_POOL_SIZE=5
FINTRACKER_DB__API_MAX_OVERFLOW=2
FINTRACKER_DB__WORKER_POOL_SIZE=5
FINTRACKER_DB__WORKER_MAX_OVERFLOW=2
FINTRACKER_DB__SCHEDULER_POOL_SIZE=2
FINTRACKER_DB__SCHEDULER_MAX_OVERFLOW=0

# --- Telegram (BL-03) ------------------------------------------------------
FINTRACKER_TELEGRAM__BOT_TOKEN=
FINTRACKER_TELEGRAM__WEBHOOK_SECRET=
FINTRACKER_TELEGRAM__WEBHOOK_BASE_URL=
FINTRACKER_TELEGRAM__BOT_ID=0
# open | allowlist — режим аудитории (OPEN-04 / BL-05)
FINTRACKER_TELEGRAM__CREATION_MODE=allowlist
FINTRACKER_TELEGRAM__CREATION_ALLOWLIST=

# --- AI профиль приложения (ADR-17). Менять только новым ADR. --------------
FINTRACKER_AI__ENABLED=false
FINTRACKER_AI__BASE_URL=https://api.openai.com/v1
FINTRACKER_AI__API_KEY=
FINTRACKER_AI__MODEL=gpt-5.6-luna
FINTRACKER_AI__REASONING_EFFORT=medium
FINTRACKER_AI__SERVICE_TIER=default
FINTRACKER_AI__REQUEST_TIMEOUT_SECONDS=90
FINTRACKER_AI__MONTHLY_COST_LIMIT=50.00
FINTRACKER_AI__COST_CURRENCY=USD
FINTRACKER_AI__MAX_CONCURRENT_INTERACTIVE=4
FINTRACKER_AI__MAX_CONCURRENT_REVIEW=1
FINTRACKER_AI__MAX_CONCURRENT_PER_WORKSPACE=2
# Тариф выбранной модели для резервирования стоимости (USD за 1M токенов)
FINTRACKER_AI__PRICE_INPUT_PER_MTOK=1.25
FINTRACKER_AI__PRICE_CACHED_INPUT_PER_MTOK=0.125
FINTRACKER_AI__PRICE_OUTPUT_PER_MTOK=10.00

# --- ASR (BL-02: конкретная модель ещё не выбрана) -------------------------
# none | openai | stub   ("none" => голос принимается, но уходит в черновик)
FINTRACKER_ASR__PROVIDER=none
FINTRACKER_ASR__MODEL=
FINTRACKER_ASR__API_KEY=
FINTRACKER_ASR__BASE_URL=https://api.openai.com/v1
FINTRACKER_ASR__MAX_AUDIO_SECONDS=180
FINTRACKER_ASR__REQUEST_TIMEOUT_SECONDS=90
FINTRACKER_ASR__PRICE_PER_MINUTE=0.006

# --- Объектное хранилище (ADR-11) -----------------------------------------
FINTRACKER_STORAGE__BACKEND=filesystem       # filesystem | s3
FINTRACKER_STORAGE__ROOT=./var/objects
FINTRACKER_STORAGE__S3_ENDPOINT=http://localhost:9100
FINTRACKER_STORAGE__S3_BUCKET=fintracker
FINTRACKER_STORAGE__S3_ACCESS_KEY=
FINTRACKER_STORAGE__S3_SECRET_KEY=

# --- Независимый журнал изменений доступа (ADR-14, SEC-10) ----------------
FINTRACKER_SECURITY_LOG__BACKEND=filesystem  # filesystem | s3
FINTRACKER_SECURITY_LOG__ROOT=./var/security-log
FINTRACKER_SECURITY_LOG__S3_BUCKET=fintracker-security-log

# --- Ключи приложения ------------------------------------------------------
# HMAC-ключ для проверочных значений кодов приглашений (SEC-04)
FINTRACKER_SECRETS__INVITE_HMAC_KEY=change-me-invite-key
FINTRACKER_SECRETS__INVITE_HMAC_KEY_VERSION=1
# Ключ подписи курсоров пагинации (ADR-09)
FINTRACKER_SECRETS__CURSOR_HMAC_KEY=change-me-cursor-key

# --- Лимиты и таймауты (ADR-04, ADR-12) -----------------------------------
FINTRACKER_LIMITS__LOCK_TIMEOUT_MS=2000
FINTRACKER_LIMITS__STATEMENT_TIMEOUT_MS=5000
FINTRACKER_LIMITS__REPORT_STATEMENT_TIMEOUT_MS=10000
FINTRACKER_LIMITS__BATCH_STATEMENT_TIMEOUT_MS=60000
FINTRACKER_LIMITS__IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
FINTRACKER_LIMITS__MAX_ATTACHMENT_BYTES=15728640
FINTRACKER_LIMITS__MAX_IMAGE_PIXELS=40000000
FINTRACKER_LIMITS__MAX_IMAGE_SIDE=16384
FINTRACKER_LIMITS__MAX_IMPORT_ROWS=5000
FINTRACKER_LIMITS__MAX_MERGE_TRANSACTIONS=5000

# --- Наблюдаемость ---------------------------------------------------------
FINTRACKER_OBSERVABILITY__LOG_LEVEL=INFO
FINTRACKER_OBSERVABILITY__LOG_FORMAT=json
